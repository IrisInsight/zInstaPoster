# ─────────────────────────────────────────────────────────────
# zInstaPoster — environment variables
#
# Per-account Instagram tokens are NOT here. They rotate on a ~60-day
# cycle and live encrypted in the database. Only the app-level Meta
# credentials belong in env.
#
# Everything below is optional for a first local run: with an empty
# .env the app uses PGlite for the database and local disk for blobs,
# and tells you in the UI which capabilities are switched off.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.vercel.app
NODE_ENV=development

# ── Meta / Instagram ─────────────────────────────────────────
# developers.facebook.com → your app → Settings → Basic
# App stays in DEVELOPMENT mode. Instagram Login (not FB Login for Business).
META_APP_ID=
META_APP_SECRET=
# Pin explicitly. v20.0 sunset 2026-09-24. Do not call unversioned.
META_API_VERSION=v25.0
# Must exactly match the redirect URI registered in the Meta app
META_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/instagram/callback
# Random string you choose; Meta echoes it back on webhook verification
META_WEBHOOK_VERIFY_TOKEN=

# ── Anthropic (copy generation) ──────────────────────────────
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# ── Google Gemini / Nano Banana (photo generation) ───────────
# aistudio.google.com → Get API key
# Move to Vertex AI only if this ever needs to touch PHI (BAA coverage).
# Generating stock-style photos does not.
GEMINI_API_KEY=
# Confirm the current model id at signup — this tier moves fast
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# ── Database ─────────────────────────────────────────────────
# Neon or Supabase Postgres. Unset → PGlite under ./.pglite for local dev.
DATABASE_URL=
PGLITE_DIR=./.pglite
# 32-byte key for encrypting Instagram access tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Vercel Blob (rendered slide JPEGs) ───────────────────────
# Must produce PUBLIC, non-expiring URLs — Meta fetches them at publish time.
# Unset → local disk under ./.storage served from /api/media/… , which is fine
# for development but is NOT reachable by Meta.
BLOB_READ_WRITE_TOKEN=
LOCAL_STORAGE_DIR=./.storage

# ── Renderer ─────────────────────────────────────────────────
# Optional. Point at a Chromium binary instead of Playwright's download or
# @sparticuz/chromium (which is used automatically on Vercel).
CHROMIUM_EXECUTABLE_PATH=

# ── Scheduler ────────────────────────────────────────────────
# QStash (Upstash). Vercel Cron is too coarse for minute-level publishing.
# Unset → in-process timers plus the /api/jobs/sweep safety net.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Shared secret protecting internal job endpoints
CRON_SECRET=

# ── Auth ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://your-app.vercel.app
# Used by npm run db:seed for the first account
SEED_USER_EMAIL=owner@precision-vitality.com
SEED_USER_PASSWORD=

# ── Alerting ─────────────────────────────────────────────────
# REQUIRED IN PRACTICE. A silent token-refresh failure kills publishing
# until the account owner re-authorizes, and nobody notices until a post
# fails to go out. Wire at least one of these.
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
